FROM python:3.12-slim

WORKDIR /app

# Install tools required by healthcheck, git-aware indexing and PG backups
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies — exclude heavy ML packages not needed for dev API
COPY requirements.txt .
RUN pip install --no-cache-dir \
    fastapi \
    "uvicorn[standard]" \
    pydantic \
    asyncpg \
    "bcrypt>=4.0,<5.0" \
    "python-jose[cryptography]" \
    "redis[hiredis]" \
    falkordb \
    structlog \
    "prometheus-client" \
    tree-sitter \
    httpx \
    mcp \
    sse-starlette

# Copy source
COPY src/ ./src/
COPY extensions/ ./extensions/

# Create data dir for SQLite auth DB
RUN mkdir -p /app/data

# Entrypoint: init DB then start server
COPY docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PYTHONPATH=/app/src
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
