FROM postgres:16-bookworm AS postgres-client

FROM python:3.12-slim-bookworm AS runtime-base

WORKDIR /app

# Install tools required by healthcheck, git-aware indexing and PG backups
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    libpq5 libreadline8 liblz4-1 libzstd1 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=postgres-client /usr/lib/postgresql/16/bin/pg_dump /usr/lib/postgresql/16/bin/psql /usr/local/bin/
COPY --from=postgres-client /usr/lib/*/libpq.so.5* /usr/local/lib/
COPY --from=postgres-client /usr/share/doc/postgresql-client-16/copyright /usr/share/doc/cga-postgresql-client-16/copyright
COPY --from=postgres-client /usr/share/doc/libpq5/copyright /usr/share/doc/cga-libpq/copyright
RUN ldconfig && pg_dump --version && psql --version

FROM runtime-base AS runtime

# Use canonical runtime constraints without optional ML or test dependencies.
COPY requirements.txt .
RUN grep -vE '^(sentence-transformers|numpy|pytest|black|ruff|mypy|pip-audit)' \
        requirements.txt > /tmp/cga-runtime-requirements.txt \
    && pip install --no-cache-dir -r /tmp/cga-runtime-requirements.txt \
    && rm /tmp/cga-runtime-requirements.txt

# Copy source
COPY src/ ./src/
COPY extensions/ ./extensions/

# Create data dir for SQLite auth DB
RUN mkdir -p /app/data

# Entrypoint: init DB then start server
COPY docker-entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh

ENV PYTHONPATH=/app/src
EXPOSE 8000
ENTRYPOINT ["/entrypoint.sh"]
